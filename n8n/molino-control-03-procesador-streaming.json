      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "f05ef16a-053f-434d-876f-bce87beda226",
      "name": "Resultado verificable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        100
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;const j=r.data?.[0];if(r.ok!==true||!j?.id||!j.finished_at)throw new Error('No se confirmó el cierre.');return [{json:{ok:true,job_id:j.id,status:j.status,finished_at:j.finished_at,publication_performed:false,detalle:j.status==='rechazado'?'Archivo retenido por validación. Revisar import_errors.':'Validación estructural terminada. Revisión de negocio pendiente.'}}];"
      }
    },
    {
      "id": "51f6eae6-d240-4fd2-97f7-f87af8f562df",
      "name": "Preparar recuperación",
