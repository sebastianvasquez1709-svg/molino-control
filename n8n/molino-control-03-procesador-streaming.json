    {
      "id": "b9bc014e-0140-4303-96ed-b4f226928101",
      "name": "Trabajo disponible",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        200
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json; if(r.ok!==true||!Array.isArray(r.data)) throw new Error('La cola no confirmó una respuesta válida.'); if(r.data.length>1) throw new Error('Solo se permite un trabajo por ejecución.'); return r.data.map(j=>({json:{job_id:j.id,file_name:j.file_name,attempt_count:j.attempt_count,worker_id:$('Crear contexto').first().json.worker_id}}));"
      }
    },
    {
      "id": "6b2b4266-ff3c-4a7f-8f14-93cd03822517",
      "name": "Procesar Excel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://molino-control.vercel.app/api/n8n-import-parser",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({job_id:$json.job_id,worker_id:$json.worker_id}) }}",
        "options": {
          "timeout": 300000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "lFukJttBNR46Wnyg",
          "name": "Molino Control RPC Token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "95d3b7fc-a84b-479c-83a4-75f65630cffb",
      "name": "Validar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        100
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json; const j=$('Trabajo disponible').first().json; if(r.ok!==true||r.job_id!==j.job_id||!['validado','rechazado'].includes(r.status)) throw new Error('Respuesta inválida del procesador.'); for(const k of ['rows_total','rows_valid','rows_error']) if(!Number.isInteger(r[k])||r[k]<0) throw new Error('Contadores inválidos.'); if(r.rows_total!==r.rows_valid+r.rows_error||r.summary?.publication_performed!==false) throw new Error('Resultado inconsistente.'); return [{json:{...r,worker_id:j.worker_id}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b45fd658-637b-4dcf-9bc1-c0229677f13a",
      "name": "Guardar resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://dadggurateghfumfcshz.supabase.co/functions/v1/molino-n8n-trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ action: \"finish\", params: {p_job_id:$json.job_id,p_worker_id:$json.worker_id,p_status:$json.status,p_rows_total:$json.rows_total,p_rows_valid:$json.rows_valid,p_rows_error:$json.rows_error,p_result_summary:$json.summary,p_last_error:null} }) }}",
        "options": {
          "timeout": 45000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "lFukJttBNR46Wnyg",
          "name": "Molino Control RPC Token"
        }
      },
