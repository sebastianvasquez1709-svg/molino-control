        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "sb_publishable_MtIFqV5vVxPNwkCxc82yOw_lCe5oFw4" }] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ p_job_id: $json.job_id, p_worker_id: `n8n-${$execution.id}`, p_status: $json.status, p_rows_total: $json.rows_total, p_rows_valid: $json.rows_valid, p_rows_error: $json.rows_error, p_result_summary: $json.summary, p_last_error: null }) }}",
        "options": {}
      },
