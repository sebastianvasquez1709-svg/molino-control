      "id": "64bfbb7c-b4b3-48d0-b7c4-73f76e44e3b9",
      "name": "Tomar trabajo con lease",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-450, 240],
      "credentials": { "httpHeaderAuth": { "id": "CONFIGURAR_EN_N8N", "name": "Molino Control RPC Token" } }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json; const jobs = Array.isArray(raw) ? raw : (raw?.id ? [raw] : []); return jobs.map(job => ({ json: { ...job, worker_id: `n8n-${$execution.id}` } }));"
      },
      "id": "d293b505-d6cb-4285-861f-8680728b88c8",
