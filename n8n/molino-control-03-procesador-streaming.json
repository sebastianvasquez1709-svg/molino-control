        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ job_id: $json.job_id, worker_id: `n8n-${$execution.id}`, signed_url: $json.signed_url, expected_checksum_sha256: $json.checksum_sha256, kind: $json.kind }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "ebfdc0f6-d655-44e5-8d59-142313419bf1",
