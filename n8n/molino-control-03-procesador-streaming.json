        "options": {
          "timeout": 45000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "lFukJttBNR46Wnyg",
          "name": "Molino Control RPC Token"
        }
      },
