      "position": [540, 240],
      "credentials": { "httpHeaderAuth": { "id": "CONFIGURAR_EN_N8N", "name": "Molino Control RPC Token" } }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json; const row = Array.isArray(raw) ? raw[0] : raw; if (!row?.id) throw new Error('Supabase no confirmó el cierre del trabajo.'); return [{ json: { ok: true, job_id: row.id, status: row.status, finished_at: row.finished_at, publication_performed: false } }];"
      },
      "id": "775a64af-b15b-468e-8670-86f1032bb639",
