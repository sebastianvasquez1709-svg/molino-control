{
  "version": 2,
  "buildCommand": "sh scripts/vercel-build-reingenieria-v1.sh",
  "outputDirectory": "public",
  "functions": {
    "api/n8n-import-parser.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index-auto.html" },
    { "source": "/cloud", "destination": "/cloud.html" },
    { "source": "/cloud/", "destination": "/cloud.html" },
    { "source": "/ine-sacos-granel-automatico-v4.js", "destination": "/ine-sacos-granel-automatico-v5.js" }
  ]
}
